# ==========================================
# GreenTrip AI - Environment Configuration
# ==========================================

# PostgreSQL / Supabase database
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/postgres

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public client key
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only keys (keep strictly in local .env or deployment secrets)
# SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_AVATAR_BUCKET=user-avatars

# Neo4j Aura
# These values must be provided only in a local .env or Render secret environment.
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

# Application environment (development | staging | production)
# In staging/production, JWT_SECRET_KEY must be a random secret >= 32 characters.
APP_ENV=development

# JWT signing (replace the placeholder with a long random secret outside this example)
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend URL (used for CORS & email verification links)
FRONTEND_URL=http://localhost:5173

# Email verification (SMTP Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=GreenTrip AI

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Gemini AI (Trip Copilot)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
